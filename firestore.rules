rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista privada de TheLoop.
    // - Cualquiera puede APUNTARSE (create) con un email válido y consentimiento.
    // - Nadie puede leer, editar ni borrar desde la web: los datos solo se ven
    //   desde la consola de Firebase o con el SDK de administración.
    // - El ID del documento es el hash del email, así un email no se duplica
    //   (un segundo create sobre el mismo ID se rechaza).
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'source', 'lang', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.consent == true
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
